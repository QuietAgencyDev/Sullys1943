{
  "name": "sullys",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:web": "npm run dev -w @sullys/web",
    "dev:api": "npm run dev -w @sullys/api",
    "dev:staff": "npm run dev -w @sullys/staff",
    "db:seed": "npm run prisma:seed -w @sullys/api",
    "db:push": "npm exec -w @sullys/api -- prisma db push",
    "db:migrate": "npm exec -w @sullys/api -- prisma migrate dev",
    "db:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:setup": "npm run db:up && npm run db:push && npm run db:seed",
    "db:sqlite": "node scripts/use-db.mjs sqlite && npm run db:push",
    "db:postgres": "node scripts/use-db.mjs postgres && npm run db:setup",
    "stripe:check": "node scripts/check-stripe.mjs",
    "manuals:pdf": "node scripts/generate-instruction-manuals.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
