# API local env
# Default without Docker:
DATABASE_URL="file:./dev.db"
# After Docker Desktop + `npm run db:postgres`:
# DATABASE_URL="postgresql://sullys:sullys@localhost:5432/sullys"
PORT=4000
WEB_ORIGIN=http://localhost:3000
STAFF_ORIGIN=http://localhost:3001
JWT_SECRET=sullys-dev-secret-change-me

# Billing: leave empty for mock checkout at /join/pay
# STRIPE_SECRET_KEY=sk_test_...
# Moneris Checkout (donate + store). When unset, mock /pay/mock is used.
# MONERIS_STORE_ID=
# MONERIS_API_TOKEN=
# MONERIS_CHECKOUT_ID=
# MONERIS_ENV=qa

# STRIPE_WEBHOOK_SECRET=whsec_...
