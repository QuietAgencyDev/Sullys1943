# Paste into Railway → Variables (Quiet Agency project)
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
JWT_SECRET=replace-with-long-random-string
PORT=4000
NODE_ENV=production

# Public site origins (password-reset links + CORS)
WEB_ORIGIN=https://www.YOURDOMAIN.com
STAFF_ORIGIN=https://staff.YOURDOMAIN.com
CORS_ORIGINS=https://www.YOURDOMAIN.com,https://YOURDOMAIN.com,https://staff.YOURDOMAIN.com

# Optional billing (leave unset = mock checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
