# Root env example — copy into apps/api/.env and apps/web/.env.local as needed
WEB_ORIGIN=http://localhost:3000
STAFF_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000

# Database (after `npm run db:up`)
DATABASE_URL=postgresql://sullys:sullys@localhost:5432/sullys
REDIS_URL=redis://localhost:6379

# Billing
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
JWT_SECRET=sullys-dev-secret-change-me

# Quiet Agency (footer credit)
# NEXT_PUBLIC_QUIET_AGENCY_URL=https://quietagency.co

# Production CORS extras (comma-separated)
# CORS_ORIGINS=https://www.yourdomain.com,https://staff.yourdomain.com

